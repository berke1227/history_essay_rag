# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# --- LLM sağlayıcısı ---
# Seçenekler: ollama | mock
# mock: API anahtarı/kurulum gerektirmez, boru hattını denemek için
TDRAG_LLM_PROVIDER=ollama
TDRAG_LLM_MODEL=qwen3.5:4b

# --- Embedding ---
# Seçenekler: sentence-transformer (üretim, ilk çalıştırmada model indirir) | hashing (test amaçlı, indirme yok)
TDRAG_EMBEDDING_BACKEND=sentence-transformer
TDRAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Klasörler ---
TDRAG_ARTICLES_FOLDER=makaleler
TDRAG_CHROMA_DIR=.chroma
TDRAG_COLLECTION_NAME=turk_devletleri

# --- Chunking ---
TDRAG_CHUNK_SIZE_WORDS=220
TDRAG_CHUNK_OVERLAP_WORDS=40

# --- Retrieval ---
TDRAG_TOP_K=4
# ÖNEMLİ: embedding modeline göre kalibre edin (bkz. README "Eşik kalibrasyonu")
TDRAG_SIMILARITY_THRESHOLD=0.25
TDRAG_DEDUP_JACCARD_THRESHOLD=0.85
# Bağlama dahil edilecek maksimum toplam kelime sayısı (aşırı bağlam yükünü önler)
TDRAG_MAX_CONTEXT_WORDS=1000

# --- Token ve Bağlam Penceresi Sınırları ---
# Modelin toplam bağlam penceresi (Ollama num_ctx: 6144 = 6k)
TDRAG_LLM_NUM_CTX=6144
# Yanıt üretimi için maksimum çıkış token sınırı (num_predict)
TDRAG_LLM_MAX_OUTPUT_TOKENS=500
# Doğrulama adımı için maksimum çıkış token sınırı (JSON için yeterli ve hızlı)
TDRAG_LLM_VERIFY_MAX_TOKENS=250

# --- Üret -> doğrula döngüsü ---
TDRAG_MAX_VERIFICATION_ATTEMPTS=3
TDRAG_MIN_ANSWER_WORD_COUNT=40

